{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/overlay/**",
              "components/panel/**",
              "ui_kits/desktop-panel/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentTraceStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|agent|done|key|ref|className|style|children)$/]",
        "message": "<AgentTraceStep> doesn't accept that prop. Declared props: label, agent, done."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApprovalBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:verb|target|preview|meta|onApprove|onReject|key|ref|className|style|children)$/]",
        "message": "<ApprovalBox> doesn't accept that prop. Declared props: verb, target, preview, meta, onApprove, onReject."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|ok)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'ok'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:accent|icon|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: accent, icon, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CountChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|urgent|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CountChip> doesn't accept that prop. Declared props: label, count, urgent, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MailResultCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:sender|subject|preview|tag|onClick|style|key|ref|className|style|children)$/]",
        "message": "<MailResultCard> doesn't accept that prop. Declared props: sender, subject, preview, tag, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotificationToast'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|message|side|onClick|onClose|key|ref|className|style|children)$/]",
        "message": "<NotificationToast> doesn't accept that prop. Declared props: icon, title, message, side, onClick, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotificationToast'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<NotificationToast> side must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrbLed'] > JSXAttribute > JSXIdentifier[name!=/^(?:face|busy|size|title|onClick|key|ref|className|style|children)$/]",
        "message": "<OrbLed> doesn't accept that prop. Declared props: face, busy, size, title, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrbLed'] > JSXAttribute[name.name='face'] > Literal[value!=/^(?:idle|grin|look|wink|sleepy|sorry|mail|bell|cal|check|clock|heart|ouch)$/]",
        "message": "<OrbLed> face must be one of 'idle' | 'grin' | 'look' | 'wink' | 'sleepy' | 'sorry' | 'mail' | 'bell' | 'cal' | 'check' | 'clock' | 'heart' | 'ouch'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrbPeek'] > JSXAttribute > JSXIdentifier[name!=/^(?:app|label|action|onClick|onClose|key|ref|className|style|children)$/]",
        "message": "<OrbPeek> doesn't accept that prop. Declared props: app, label, action, onClick, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='PanelShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|icon|onClose|footer|children|style|key|ref|className|style|children)$/]",
        "message": "<PanelShell> doesn't accept that prop. Declared props: title, icon, onClose, footer, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignalButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|count|urgent|title|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SignalButton> doesn't accept that prop. Declared props: kind, count, urgent, title, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignalButton'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:cal|mail|todo|bell|timer)$/]",
        "message": "<SignalButton> kind must be one of 'cal' | 'mail' | 'todo' | 'bell' | 'timer'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:follow|urgent)$/]",
        "message": "<Tag> tone must be one of 'follow' | 'urgent'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
